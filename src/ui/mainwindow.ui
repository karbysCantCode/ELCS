  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background: rgb(11, 11, 17);
}

QWidget#centralwidget {
    background: rgb(11, 11, 17);
}

QTabWidget#tabWidget QWidget[variant=&quot;page&quot;] {
 background: rgb(30, 30, 50);
}

QTabBar {
    background: rgb(35, 35, 35);
}

QTabBar::tab {
    background: rgb(58, 58, 58);
    color: white;
    padding: 6px 14px;
}

QTabBar::tab:selected {
    background: rgb(43, 43, 43);
}

QTabWidget::pane {
    background: #2b2b2b;
    border: 1px solid #555;
}

QTabBar::tab {
    background: #3a3a3a;
    color: white;
    padding: 6px 12px;
}

QTabBar::tab:selected {
    background: #4a4a4a;
}

QTabBar::tab:hover {
    background: #505050;
}

QTextEdit {
    background: #3a3a3a;
    color: white;
    border: 1px solid #555;
    border-radius: 4px;
    padding: 8px;
    font-size: 14px;
}

QTextEdit:focus {
    border: 1px solid #4da6ff;
}

QPushButton[variant=&quot;create&quot;] {
    background: rgb(30, 59, 84);
    color: white;
    border: 1px solid #a3ccff;
    border-radius: 4px;
    padding: 8px 18px;
    font-size: 14px;
}

QPushButton[variant=&quot;create&quot;]:hover {
    background: rgb(45, 78, 107);
	border: 1px solid #a3ccff;
}

QPushButton[variant=&quot;create&quot;]:pressed {
    background: rgb(20, 42, 60);
	border: 1px solid #a3ccff;
}

QPushButton {
    background: #444444;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 8px 18px;
    font-size: 14px;
}

QPushButton:hover {
    background: #555555;
}

QPushButton:pressed {
    background: #333333;
}

QPushButton#mainButton {
    background: #2d8cff;
    color: white;
    border: 1px solid #a3ccff;
    border-radius: 4px;
    padding: 8px 18px;
    font-size: 14px;
}

QFrame#toolbar QToolButton {
    background: rgb(30, 59, 84);
    color: white;
	border: 1px solid #a3ccff;
    border-radius: 4px;
    padding: 2px 2px;
    font-size: 14px;
}

QFrame#toolbar QToolButton:hover {
    background: rgb(45, 78, 107);
}

QFrame#toolbar QToolButton:pressed {
    background: rgb(20, 42, 60);
}

QPushButton#mainButton:hover {
    background: #4da6ff;
}

QPushButton#mainButton:pressed {
    background: #1c6dcc;
}

QPushButton#dangerButton {
    background: #d9534f;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 8px 18px;
    font-size: 14px;
}

QPushButton#dangerButton:hover {
    background: #e57373;
}

QPushButton#dangerButton:pressed {
    background: #b52b27;
}


QFrame {
    background: #2b2b2b;
}

QFrame#secondaryFrame {
    background: #333333;
}

QFrame#cardFrame {
    background: #3a3a3a;
    border-radius: 4px;
    border: 1px solid #555555;
}


QWidget#overlay {
    background: rgba(0,0,0,120);
}


QLabel {
    color: #dddddd;
    font-size: 14px;
}


QLabel#titleLabel {
    color: white;
    font-size: 20px;
    font-weight: bold;
}


QLabel#secondaryLabel {
    color: #aaaaaa;
    font-size: 12px;
}


QLabel#errorLabel {
    color: #ff6b6b;
    font-size: 13px;
    font-weight: bold;
}


QLabel#successLabel {
    color: #4caf50;
    font-size: 13px;
    font-weight: bold;
}</string>
