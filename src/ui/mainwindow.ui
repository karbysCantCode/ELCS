  <property name="styleSheet">
   <string notr="true">/* =========================================================
   GLOBAL
   ========================================================= */

QMainWindow {
    background: #080a0f;
}

QWidget#centralwidget {
    background: #080a0f;
}

QWidget {
    color: #e5e7eb;
}


/* =========================================================
   TOOL BUTTONS
   ========================================================= */

QToolButton {
    background: #151923;
    color: #e5e7eb;
    border: 1px solid #303542;
    border-radius: 4px;
    padding: 2px 4px;
    font-size: 14px;
}

QToolButton:hover {
    background: #1d2230;
    border: 1px solid #3b4659;
}

QToolButton:pressed {
    background: #10131a;
}

QToolButton:checked {
    background: #202a3a;
    border: 1px solid #4b6b91;
}


/* =========================================================
   TABS
   ========================================================= */

QTabWidget {
    background: #101218;
}

QTabWidget::pane {
    background: #11141b;
    border: 1px solid #292d37;
}

QTabBar {
    background: #0b0d12;
}

QTabBar::tab {
    background: #11141a;
    color: #8f96a3;
    padding: 6px 14px;
    border: 1px solid transparent;
}

QTabBar::tab:hover {
    background: #181c25;
    color: #c7ccd5;
}

QTabBar::tab:selected {
    background: #1b1f29;
    color: #ffffff;
    border-bottom: 2px solid #3d8cff;
}


/* =========================================================
   TEXT EDIT
   ========================================================= */

QTextEdit {
    background: #11141a;
    color: #e5e7eb;
    border: 1px solid #2d323d;
    border-radius: 4px;
    padding: 8px;
    font-size: 14px;
    selection-background-color: #294b73;
    selection-color: white;
}

QTextEdit:hover {
    border: 1px solid #3a414f;
}

QTextEdit:focus {
    border: 1px solid #3d8cff;
}


/* =========================================================
   BUTTONS
   ========================================================= */

QPushButton {
    background: #1a1d25;
    color: #e5e7eb;
    border: 1px solid #303541;
    border-radius: 4px;
    padding: 8px 18px;
    font-size: 14px;
}

QPushButton:hover {
    background: #222631;
    border: 1px solid #3c4351;
}

QPushButton:pressed {
    background: #12151b;
}


/* =========================================================
   CREATE BUTTON
   ========================================================= */

QPushButton[variant=&quot;create&quot;] {
    background: #18283a;
    color: #e8f2ff;
    border: 1px solid #426487;
    border-radius: 4px;
    padding: 8px 18px;
    font-size: 14px;
}

QPushButton[variant=&quot;create&quot;]:hover {
    background: #20364d;
    border: 1px solid #527ba5;
}

QPushButton[variant=&quot;create&quot;]:pressed {
    background: #122131;
}


/* =========================================================
   MAIN BUTTON
   ========================================================= */

QPushButton#mainButton {
    background: #216dcc;
    color: white;
    border: 1px solid #5597ed;
    border-radius: 4px;
    padding: 8px 18px;
    font-size: 14px;
}

QPushButton#mainButton:hover {
    background: #2b7fe5;
}

QPushButton#mainButton:pressed {
    background: #1856a3;
}


/* =========================================================
   DANGER BUTTON
   ========================================================= */

QPushButton#dangerButton {
    background: #642a2a;
    color: #ffdddd;
    border: 1px solid #8b3b3b;
    border-radius: 4px;
    padding: 8px 18px;
    font-size: 14px;
}

QPushButton#dangerButton:hover {
    background: #7b3030;
}

QPushButton#dangerButton:pressed {
    background: #4d2020;
}


/* =========================================================
   FRAMES / PANELS
   ========================================================= */

QFrame {
    background: #11141b;
}

QFrame#secondaryFrame {
    background: #171a22;
}

QFrame#cardFrame {
    background: #1b1f28;
    border-radius: 5px;
    border: 1px solid #2c313c;
}


/* =========================================================
   OVERLAY
   ========================================================= */

QWidget#overlay {
    background: rgba(0, 0, 0, 175);
}


/* =========================================================
   LABELS
   ========================================================= */

QLabel {
    color: #d5d9e0;
    font-size: 14px;
}

QLabel#titleLabel {
    color: #f3f4f6;
    font-size: 20px;
    font-weight: bold;
}

QLabel#secondaryLabel {
    color: #858c99;
    font-size: 12px;
}

QLabel#errorLabel {
    color: #ff6b6b;
    font-size: 13px;
    font-weight: bold;
}

QLabel#successLabel {
    color: #5fc77b;
    font-size: 13px;
    font-weight: bold;
}


/* =========================================================
   SCROLLBARS
   ========================================================= */

QScrollBar:vertical {
    background: #0b0d12;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #292e38;
    min-height: 25px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #383f4c;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #0b0d12;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #292e38;
    min-width: 25px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: #383f4c;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}


/* =========================================================
   LINE EDIT
   ========================================================= */

QLineEdit {
    background: #11141a;
    color: #e5e7eb;
    border: 1px solid #2d323d;
    border-radius: 4px;
    padding: 7px 8px;
    font-size: 14px;
    selection-background-color: #294b73;
}

QLineEdit:hover {
    border: 1px solid #3a414f;
}

QLineEdit:focus {
    border: 1px solid #3d8cff;
}


/* =========================================================
   CHECKBOXES
   ========================================================= */

QCheckBox {
    color: #d5d9e0;
    spacing: 7px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    background: #11141a;
    border: 1px solid #3a404c;
    border-radius: 3px;
}

QCheckBox::indicator:hover {
    border: 1px solid #4b5565;
}

QCheckBox::indicator:checked {
    background: #216dcc;
    border: 1px solid #5597ed;
}


/* =========================================================
   COMBO BOX
   ========================================================= */

QComboBox {
    background: #11141a;
    color: #e5e7eb;
    border: 1px solid #2d323d;
    border-radius: 4px;
    padding: 6px 8px;
}

QComboBox:hover {
    border: 1px solid #3a414f;
}

QComboBox:focus {
    border: 1px solid #3d8cff;
}

QComboBox QAbstractItemView {
    background: #151820;
    color: #e5e7eb;
    border: 1px solid #303541;
    selection-background-color: #24364d;
    selection-color: white;
}</string>
